{
  "expo": {
    "name": "Camen",
    "slug": "camen",
    "version": "1.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0E",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0B0C0E",
      "resizeMode": "contain"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.camen.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camen needs the camera to take photos.",
        "NSPhotoLibraryAddUsageDescription": "Camen saves your photos to your gallery."
      }
    },
    "android": {
      "package": "com.camen.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochrome": "./assets/monochrome.png",
        "backgroundColor": "#0B0C0E"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Camen saves your photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Camen uses your location to tag photos when Location is enabled."
        }
      ],
      "expo-sqlite"
    ]
  }
}